# Stripe test keys: https://dashboard.stripe.com/test/apikeys
# Use the test secret (sk_test_...) until you are ready to take real payments.
STRIPE_SECRET_KEY=
# Signing secret from `stripe listen --forward-to localhost:5173/api/stripe/webhook`
# or from the webhook endpoint in the Stripe Dashboard (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Password for /admin.html. Use at least 12 characters.
ADMIN_PASSWORD=

# Optional. Leave unset in local development so redirects use the request host.
# In production set the public origin, for example https://esoterica.example
PUBLIC_URL=

# Optional email when a paid order is first recorded.
# Without these, the order still appears on /admin.html and in the Stripe Dashboard.
# RESEND_API_KEY=
# ORDER_FROM_EMAIL=orders@yourdomain.com
# ORDER_NOTIFY_EMAIL=
